# Cloudflare reads this on deploy and does not serve it.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Only Vite's hashed output sits directly in assets/. Levels, art and audio from public/assets live in
# subfolders and keep their names, so they stay on the default revalidating cache.
/assets/:file
  Cache-Control: public, max-age=31536000, immutable

https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
