{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "superbreaker",
  "compatibility_date": "2026-11-15",
  "routes": [
    { "pattern": "zombiehead.studio", "custom_domain": true },
    { "pattern": "www.zombiehead.studio", "custom_domain": true },
  ],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
  },
}
