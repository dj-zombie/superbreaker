{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "superbreaker",
  "compatibility_date": "2026-11-15",
  // Saves live in localStorage, which is per origin. Moving the game to another hostname leaves players' progress behind.
  "routes": [{ "pattern": "superbreaker.zombiehead.studio", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
  },
}
